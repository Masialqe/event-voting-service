<div>
    @if (Voters is { Count: > 0 })
    {
        <table class="table">
            <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Username</th>
            </tr>
            </thead>
            <tbody>
            @{
            var index = 1;
            }
            @foreach (var voter in Voters)
            {
                <tr>
                    <th scope="row">@index</th>
                    <td>@voter.Voter?.Username</td>
                </tr>

                index++;
            }
            </tbody>
        </table>
    }
</div>

@code {
    [Parameter] public ICollection<VoterEvent>? Voters { get; set; }
}