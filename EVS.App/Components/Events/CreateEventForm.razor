@inject CreateEventHandler CreateEventHandler

<EditForm Model="CreateEvent" FormName="AddEventForm" OnValidSubmit="HandleFormSubmit">
    <DataAnnotationsValidator/>
    
    <div class="mb-3">
        <InputText
            class="form-control"
            @bind-Value="@CreateEvent.Name"
            placeholder="Enter event name..."
        />
        <ValidationMessage For="@(() => CreateEvent.Name)" />
    </div>
    
    <div class="mb-3">
        <InputText class="form-control"
                   @bind-Value="@CreateEvent.Description"
                   placeholder="Enter event description..."
        />
        <ValidationMessage For="@(() => CreateEvent.Description)" />
    </div>
    
    <div class="mb-3">
        <label for="player-limit">Max players count </label>
        <InputNumber
            class="form-control"
            id="player-limit"
            @bind-Value="CreateEvent.PlayerLimit"
            TValue="int"
            min="1"
            placeholder="Enter player limit..."/>
        <ValidationMessage For="@(() => CreateEvent.PlayerLimit)"/>
    </div>

    <div class="mb-3 d-flex flex-row">
        <div class="mb-3 p-1"> 
                <InputCheckbox id="singleVoteBox"
                               @bind-Value="_isSingleVoteType"
                               @onclick="() => SwitchVoteType(EventTypes.SingleVote)"
                               class="form-check-input"
                               disabled="@_isSingleVoteType"/>
                <label for="singleVoteBox" class="form-check-label">Single vote</label>
            </div>
            <div class="mb-3 p-1">
                <InputCheckbox id="scaleVoteBox"
                               @bind-Value="_isScaleVoteType"
                               @onclick="() => SwitchVoteType(EventTypes.ScaleVote)"
                               class="form-check-input"
                               disabled="@_isScaleVoteType"/>
                <label for="scaleVoteBox" class="form-check-label">Scale vote</label>
            </div>
        <ValidationMessage For="@(() => CreateEvent.Type)" />
    </div>
    @if (CreateEvent.Type == EventTypes.ScaleVote)
    {
        <div class="mb-3">
            <label for="points-limit">Max points to earn </label>
            <InputNumber
                class="form-control"
                id="points-limit"
                @bind-Value="CreateEvent.PointsLimit"
                TValue="int"
                min="1"
                placeholder="Enter player limit..."/>
            <ValidationMessage For="@(() => CreateEvent.PointsLimit)"/>
        </div>
    }
    
    <div class="mb-3 d-flex justify-content-center">
        <button type="submit"
                class="btn btn-primary">
            + Add
        </button>
    </div>
</EditForm>
<ToolTip @ref="@_toolTip"/>

@code {
    
    [SupplyParameterFromForm] private CreateEventModel CreateEvent { get; set; } = new();
    [Parameter] public EventCallback OnEventCreated { get; set; }

    private ToolTip _toolTip = default!;
    private bool _isSingleVoteType = true;
    private bool _isScaleVoteType = false;
    
    private async Task HandleFormSubmit()
    {
        var result = await CreateEventHandler.Handle(CreateEventRequest.Create(CreateEvent.Name, CreateEvent.Description, 
            CreateEvent.Type, CreateEvent.PlayerLimit, CreateEvent.PointsLimit));
        
        if (result.IsSuccess)
        {
            ResetFormFields();
            await OnEventCreated.InvokeAsync();
        }
        
        await _toolTip.ShowMessageAsync(
            result.IsSuccess ? ToastType.Success : ToastType.Danger,
            result.IsSuccess ? "Event has been added." : result.Error.errorDescription!
        );
    }

    private void SwitchVoteType(EventTypes eventType)
    {
        _isScaleVoteType = !_isScaleVoteType;
        _isSingleVoteType = !_isSingleVoteType;
        CreateEvent.Type = eventType;
    }
    
    private void ResetFormFields()
    {
        CreateEvent = CreateEventModel.Empty;
        _isScaleVoteType = false;
        _isSingleVoteType = true;
    }
}