@inject LoadEventPageByNameHandler LoadEventPageByNameHandler
@inject NavigationManager NavigationManager
@inject SignalRService SignalRService
@inject IHttpContextAccessor HttpContextAccessor

<div class="container-fluid shadow border-2 w-75 h-100 p-4" style="min-width: 350px">
    <div class="event-list-container">
        <div class="d-flex p-3 justify-content-start gap-2 flex-wrap">
            <div>
                <EventListSearchBar
                    OnSearch="LoadEventsPageAsync"
                    OnParametersLoaded="LoadEventsPageAsync"/>
            </div>
            <button
                class="btn btn-secondary"
                @onclick="HandleShowAddEventModal"><i class="bi bi-plus-circle-fill"></i> Add</button>
        </div>
        <div class="event-list">
            @if (_events is { Length: > 0 })
            {
                <div class="event-container">
                    <div class="grid-container p-3">
                        @foreach (var ev in _events)
                        {
                            <EventCard
                                @key="ev.Id"
                                Event="@ev"
                                OnVoterJoinedEvent="HandleVoterAddedToEvent"/>
                        }
                    </div>
                    <div class="pagination-container mt-1">
                        <PaginationComponent
                            TotalPages="@_pageCount"
                            ActivePage="@_currentPage"
                            OnPageChanged="HandlePageChanged"/>
                    </div>
                </div>
            }
            else
            {
                if (_isLoading)
                {
                    <div class="d-flex justify-content-center">
                        <Spinner Type="SpinnerType.Border"/>
                    </div>
                }
                else
                {
                    <div class="text-center w-100">
                        <p>No events available...</p>
                    </div>
                }
            }
        </div>
    </div>
</div>

<ToolTip @ref="_toolTip"/>
<ModalWindow @ref="_modalWindow">
    <CreateEventForm></CreateEventForm>
</ModalWindow>

@code {
    private Event[]? _events = default!;
    
    private EventSearchBarModel _searchBarOptions = EventSearchBarModel.Empty;
    private string? _connectionId;
    
    private ToolTip? _toolTip;
    private ModalWindow? _modalWindow;
    
    private bool _isLoading = false;
    
    private int _pageCount = 1;
    private int _currentPage = 1;


    protected override async Task OnInitializedAsync()
    {
        await StartSignalRConnection();
        ListenToSignalREvents();
    }

    private async Task LoadEventsPageAsync(EventSearchBarModel searchBarModel)
    {
        ChangeLoadingState();
        if (await GetEventPageAsync(searchBarModel) is { } result)
        {
            var (events, eventsCount) = result;
            _events = events;
            _pageCount = CalculatePageCount(eventsCount, searchBarModel.PageSize);
        }

        _searchBarOptions = searchBarModel;
        ChangeLoadingState();
    }

    private async Task<(Event[], int)?> GetEventPageAsync(EventSearchBarModel searchBarModel)
    {
        var result = await LoadEventPageByNameHandler.Handle(
            LoadEventPageByNameRequest.Create(searchBarModel.EventName, searchBarModel.PageSize, _currentPage));
        if (!result.IsSuccess) return null;
        
        return result.Value;
    }
    
    private int CalculatePageCount(int totalEventsCount, int pageSize)
        => (int)Math.Ceiling((double)totalEventsCount / pageSize);

    private void ChangeLoadingState()
    {
        _isLoading = !_isLoading;
        StateHasChanged();
    }
    
    private async Task HandlePageChanged(int newPageNumber)
    {
        _currentPage = newPageNumber;
        await LoadEventsPageAsync(_searchBarOptions);
    }

    private async Task HandleShowAddEventModal()
    {
        await _modalWindow.ShowModalAsync();
    }
    
    
    private async Task HandleVoterAddedToEvent((string voterId, string eventId) input)
    {
        await SignalRService.HubConnection.InvokeAsync("AddVisitorToEventAsync", input.voterId, input.eventId);
    }

    private async Task HandleVoterAddedToEventError(Error error)
        => await _toolTip.ShowMessageAsync(ToastType.Danger, error.errorDescription ?? error.errorName);

    private void HandleVoterAddedSuccesfoultToEvent(string eventId)
    {
        NavigationManager.NavigateTo($"/event/{eventId}");
    }

    private async Task StartSignalRConnection()
    {
        _connectionId = HttpContextAccessor?.HttpContext?.Connection.Id;
        await SignalRService.StartAsync();
        await SignalRService.HubConnection.InvokeAsync("JoinGroupAsync", _connectionId);
    }

    private void ListenToSignalREvents()
    {
        SignalRService.HubConnection.On<Error>("ErrorOccured", HandleVoterAddedToEventError);
        SignalRService.HubConnection.On<string>("VoterAddedSuccessfully", HandleVoterAddedSuccesfoultToEvent);
    }
    
}