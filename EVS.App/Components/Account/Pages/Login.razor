@page "/Account/Login"
@layout EventLayout

@using EVS.App.Application.UseCases.Voters.LoginVoter
@using Microsoft.AspNetCore.Authentication
@using EVS.App.Shared.Errors

@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject LoginVoterHandler LoginVoterHandler


<PageTitle>Sign In</PageTitle>

<div class="container-fluid shadow border-2 p-4 d-flex flex-sm-column flex-lg-row flex-md-column" style="max-width: 45%; min-width: 315px;">
    <div class="d-flex flex-column">
        <h3 class="mb-4"> Sign In</h3>
        <EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login">
            <DataAnnotationsValidator/>
            <ValidationSummary class="text-danger" role="alert"/>

            <div class="input-group input-group-lg mb-3">
                <span class="input-group-text" id="username">
                    <i class="bi bi-person-circle"></i>
                </span>
                <label for="email" class="visually-hidden">Email</label>
                <InputText @bind-Value="Input.Email"
                           id="email"
                           class="form-control"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="name@example.com"
                           aria-describedby="username"/>
                <ValidationMessage For="() => Input.Email" class="text-danger"/>
            </div>

            <div class="input-group input-group-lg mb-3">
                <span class="input-group-text" id="password">
                    <i class="bi bi-keyboard"></i>
                </span>
                <label for="password" class="visually-hidden">Password</label>
                <InputText @bind-Value="Input.Password"
                           type="password"
                           class="form-control"
                           autocomplete="current-password"
                           aria-required="true"
                           placeholder="Enter your password..."
                           aria-describedby="password"/>
                <ValidationMessage For="() => Input.Password" class="text-danger"/>
            </div>

            <div class="d-flex justify-content-between align-content-center p-2 flex-sm-column flex-lg-row flex-md-column">
                <div class="checkbox mb-3">
                    <label class="form-label">
                        <InputCheckbox @bind-Value="Input.RememberMe" class="darker-border-checkbox form-check-input flex-md-column"/>
                        Remember me
                    </label>
                </div>
                <div>
                    <button type="submit" class="btn btn-light w-25">Login</button>
                </div>
            </div>
            <div class="d-flex justify-content-end p-2">
                @* <div> *@
                @*     <p> *@
                @*         <a href="@(NavigationManager.GetUriWithQueryParameters( *@
                @*                      "Account/Register", new Dictionary<string, object?> *@
                @*                          { ["ReturnUrl"] = ReturnUrl }))">Register now</a> *@
                @*     </p> *@
                @* </div> *@
                <div>
                    <p>
                        <a href="Account/ForgotPassword">Forgot password?</a>
                    </p>
                </div>
            </div>
        </EditForm>
    </div>
    <div class="border-start mx-3 mt-0"></div>
    <div class="d-flex flex-column align-content-center mx-4">
        <h3 class="mt-3"> New here?</h3>
        <p>Create your account today and start using our app!</p>
        <button
            type="button"
            class="btn btn-success"
            aria-label="Sign up"
            @onclick="HandleSignUpRedirection"> Sign Up!</button>
    </div>
</div>

@code {
    private string? _errorMessage;
    
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    public async Task LoginUser()
    {
        var request = new LoginVoterRequest(Input.Email, Input.Password, Input.RememberMe);
        var result = await LoginVoterHandler.Handle(request);
        
        if (result.IsSuccess)
        {
            RedirectManager.RedirectTo("/");
            
        }
        else if (result.Error == LoginErrors.UserRequiresTwoFactor)
        {
            RedirectManager.RedirectTo(
                "Account/LoginWith2fa",
                new() { ["returnUrl"] = ReturnUrl, ["rememberMe"] = Input.RememberMe });
        }
        else if (result.Error == LoginErrors.UserIsLockedOut)
        {
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            _errorMessage = result.Error.errorDescription;
        }
    }

    private sealed class InputModel
    {
        [Required] [EmailAddress] public string Email { get; set; } = "";

        [Required]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Display(Name = "Remember me?")] public bool RememberMe { get; set; }
    }

    private void HandleSignUpRedirection()
    {
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(
            "Account/Register", new Dictionary<string, object?>
                { ["ReturnUrl"] = ReturnUrl }));
    }

}