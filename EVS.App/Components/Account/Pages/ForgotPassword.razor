@page "/Account/ForgotPassword"
@layout EventLayout

@inject UserManager<VoterIdentity> UserManager
@inject IEmailSender<VoterIdentity> EmailSender
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Forgot your password?</PageTitle>


<div class="container-fluid shadow border-2 p-4 d-flex justify-content-center w-25">

    <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator/>
        <h3 class="mb-4"> Forgot your password? </h3>
        <hr/>
        <div class="form-floating mb-3">
            <InputText @bind-Value="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com"/>
            <label for="email" class="form-label">Email</label>
            <ValidationMessage For="() => Input.Email" class="text-danger"/>
        </div>
        <div class="d-flex justify-content-center">
            <button type="submit" class="btn btn-light w-50">Reset password</button>
        </div>
    </EditForm>
</div>

